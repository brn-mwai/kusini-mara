# ──────────────────────────────────────────────────────────────────────────────
# CycleTrack — environment template. Copy to .env.local. NEVER commit secrets.
# ──────────────────────────────────────────────────────────────────────────────

# Convex deployment (from `npx convex dev`). Then seed: `npx convex run seed:run`
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=

# Clerk: four separate applications, one per console. A console runs in demo
# tenancy mode (fixed seed org) until its key is present.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY_OEM=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY_PARTNERS=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY_FIELD=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY_ADMIN=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=

# Mapbox (find-drop-off + control tower map). Maps degrade gracefully without.
NEXT_PUBLIC_MAPBOX_TOKEN=
