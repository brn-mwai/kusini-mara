{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client", "vite-plugin-svgr/client"],
    "paths": {
      "twenty-sdk/define": ["../../packages/twenty-sdk/src/sdk/define/index.ts"],
      "twenty-shared/*": ["../../packages/twenty-shared/src/*"],
      "kusini-app": ["../../packages/kusini-app/src/index.ts"],
      "@/ai/*": ["../../packages/twenty-shared/src/ai/*"],
      "@/ai": ["../../packages/twenty-shared/src/ai/index.ts"],
      "@/application/*": ["../../packages/twenty-shared/src/application/*"],
      "@/application": ["../../packages/twenty-shared/src/application/index.ts"],
      "@/constants/*": ["../../packages/twenty-shared/src/constants/*"],
      "@/constants": ["../../packages/twenty-shared/src/constants/index.ts"],
      "@/database-events/*": ["../../packages/twenty-shared/src/database-events/*"],
      "@/database-events": ["../../packages/twenty-shared/src/database-events/index.ts"],
      "@/i18n/*": ["../../packages/twenty-shared/src/i18n/*"],
      "@/i18n": ["../../packages/twenty-shared/src/i18n/index.ts"],
      "@/logic-function/*": ["../../packages/twenty-shared/src/logic-function/*"],
      "@/logic-function": ["../../packages/twenty-shared/src/logic-function/index.ts"],
      "@/metadata/*": ["../../packages/twenty-shared/src/metadata/*"],
      "@/metadata": ["../../packages/twenty-shared/src/metadata/index.ts"],
      "@/testing/*": ["../../packages/twenty-shared/src/testing/*"],
      "@/testing": ["../../packages/twenty-shared/src/testing/index.ts"],
      "@/timeline/*": ["../../packages/twenty-shared/src/timeline/*"],
      "@/timeline": ["../../packages/twenty-shared/src/timeline/index.ts"],
      "@/translations/*": ["../../packages/twenty-shared/src/translations/*"],
      "@/translations": ["../../packages/twenty-shared/src/translations/index.ts"],
      "@/types/*": ["../../packages/twenty-shared/src/types/*"],
      "@/types": ["../../packages/twenty-shared/src/types/index.ts"],
      "@/utils/*": ["../../packages/twenty-shared/src/utils/*"],
      "@/utils": ["../../packages/twenty-shared/src/utils/index.ts"],
      "@/vite/*": ["../../packages/twenty-shared/src/vite/*"],
      "@/vite": ["../../packages/twenty-shared/src/vite/index.ts"],
      "@/workflow/*": ["../../packages/twenty-shared/src/workflow/*"],
      "@/workflow": ["../../packages/twenty-shared/src/workflow/index.ts"],
      "@/workspace/*": ["../../packages/twenty-shared/src/workspace/*"],
      "@/workspace": ["../../packages/twenty-shared/src/workspace/index.ts"],
      "@/sdk/*": ["../../packages/twenty-sdk/src/sdk/*"],
      "@ui/*": ["../../packages/twenty-ui/src/*"],
      "@assets/*": ["../../packages/twenty-ui/src/assets/*"],
      "@styles/*": ["../../packages/twenty-ui/src/styles/*"],
      "@convex/*": ["../../convex/_generated/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
